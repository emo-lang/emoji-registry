package twofa

import (
	"strconv"

	"github.com/emo-lang/emoji-registry/app/views/layouts"
)

// Setup renders the enrollment page: scan the QR code (or type the secret)
// and confirm with a current code.
templ Setup(username string, qrDataURI string, secret string, err string) {
	@layouts.Base("Set up two-factor authentication", username, false) {
		<main class="er-page" style="max-width: 480px;">
			<style>
				.totp-qr { display: block; width: 220px; height: 220px; margin: 16px auto; image-rendering: pixelated; }
				.totp-secret { font-size: 15px; user-select: all; letter-spacing: 1px; }
			</style>
			<h1>Set up two-factor authentication</h1>
			<p class="er-muted">Two-factor authentication is required. Scan this code with an authenticator app (Google Authenticator, 1Password, Authy, …), or enter the secret manually.</p>
			<img class="totp-qr" src={ qrDataURI } alt="TOTP QR code" width="220" height="220"/>
			<p class="er-muted">Secret key:</p>
			<pre class="er-code totp-secret">{ secret }</pre>
			if err != "" {
				<div class="er-error">{ err }</div>
			}
			<form method="post" action="/account/2fa/setup">
				<div class="er-field">
					<label for="code">Enter the 6-digit code from your app</label>
					<input class="er-input" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required autofocus/>
				</div>
				<button class="er-btn" type="submit">Enable two-factor authentication</button>
			</form>
		</main>
	}
}

// Recovery shows the one-time recovery codes right after enrollment.
templ Recovery(username string, admin bool, codes string) {
	@layouts.Base("Recovery codes", username, admin) {
		<main class="er-page" style="max-width: 560px;">
			<h1>Save your recovery codes</h1>
			<p>If you lose access to your authenticator app, each of these codes signs you in once. <strong>They will never be shown again.</strong></p>
			<pre class="er-code" style="font-size: 16px; line-height: 1.7; user-select: all;">{ codes }</pre>
			<p class="er-muted">Store them somewhere safe and offline. You can generate a new set later from the security page, as long as you can still produce a TOTP code.</p>
			<p><a class="er-btn" href="/">Continue to the registry</a></p>
		</main>
	}
}

// Challenge asks a pending session for its second factor.
templ Challenge(username string, err string) {
	@layouts.Base("Two-factor authentication", username, false) {
		<main class="er-page" style="max-width: 420px;">
			<h1>Two-factor authentication</h1>
			<p class="er-muted">Enter the 6-digit code from your authenticator app, or one of your recovery codes.</p>
			if err != "" {
				<div class="er-error">{ err }</div>
			}
			<form method="post" action="/login/2fa">
				<div class="er-field">
					<label for="code">Code</label>
					<input class="er-input" id="code" name="code" autocomplete="one-time-code" required autofocus/>
				</div>
				<button class="er-btn" type="submit">Verify</button>
			</form>
		</main>
	}
}

// Security is the account security page: current second-factor status and
// recovery-code regeneration.
templ Security(username string, admin bool, enabled bool, remaining int, newCodes string, err string) {
	@layouts.Base("Account security", username, admin) {
		<main class="er-page" style="max-width: 560px;">
			<h1>Account security</h1>
			<section>
				<h2>Two-factor authentication</h2>
				if enabled {
					<p>Two-factor authentication is enabled for this account.</p>
					<p class="er-muted">Unused recovery codes: { strconv.Itoa(remaining) }.</p>
				} else {
					<p>Two-factor authentication is not enabled for this session. Sign out and sign in again to complete enrollment.</p>
				}
			</section>
			if enabled {
				<section style="margin-top: 28px;">
					<h2>Recovery codes</h2>
					if newCodes != "" {
						<p>Your new codes — <strong>they will never be shown again</strong>:</p>
						<pre class="er-code" style="font-size: 16px; line-height: 1.7; user-select: all;">{ newCodes }</pre>
					}
					if err != "" {
						<div class="er-error">{ err }</div>
					}
					<form method="post" action="/account/2fa/recovery-codes">
						<p class="er-muted">Generating new codes invalidates the old ones. Confirm with a current 6-digit code from your app.</p>
						<div class="er-field">
							<label for="code">Authenticator code</label>
							<input class="er-input" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required/>
						</div>
						<button class="er-btn" type="submit">Generate new recovery codes</button>
					</form>
				</section>
			}
		</main>
	}
}
