package layouts

import (
	"github.com/daqing/airway/app/assets"
	"github.com/daqing/airway/lib/utils"
)

// BaseOptions tunes the shared document shell for a single page.
type BaseOptions struct {
	// Description, when set, is emitted as the meta description and
	// og:description.
	Description string
	// ShowSidebar renders the right-hand tips column. It is opt-in: only
	// pages where the publishing hints genuinely help (the home page) set it.
	ShowSidebar bool
}

// baseOptions unwraps the optional BaseOptions argument, treating a missing
// one as the zero value.
func baseOptions(opts []BaseOptions) BaseOptions {
	if len(opts) > 0 {
		return opts[0]
	}
	return BaseOptions{}
}

// Base renders the shared HTML document shell with the registry top
// navigation. username is empty when the visitor is not logged in; admin
// shows the /admin link. The optional opts carry per-page tweaks — a meta
// description and whether to show the tips sidebar. Page templates wrap their
// content in this component, e.g.:
//
//	@layouts.Base("My Title", "", false) {
//		<p>Page body…</p>
//	}
templ Base(title string, username string, admin bool, opts ...BaseOptions) {
	{{ o := baseOptions(opts) }}
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			if o.Description != "" {
				<meta name="description" content={ o.Description }/>
				<meta property="og:title" content={ title }/>
				<meta property="og:description" content={ o.Description }/>
				<meta property="og:type" content="website"/>
				<meta name="theme-color" content="#101319"/>
			}
			<script>
				// Apply the stored (or OS) theme before the first paint so a
				// dark-mode visitor never sees a flash of the light theme.
				(function () {
					try {
						var stored = localStorage.getItem("theme");
						var theme = stored === "light" || stored === "dark"
							? stored
							: (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
						document.documentElement.dataset.theme = theme;
					} catch (e) { /* private mode: fall back to the CSS default */ }
				})();
			</script>
			<style>
				:root {
					--er-bg: #fafaf7; --er-ink: #232820; --er-muted: #6d7369;
					--er-line: #dfe2d7; --er-accent: #5d763c; --er-code-bg: #f0f2ea;
				}
				/* An explicit choice (set by the header toggle) wins; without
				   JavaScript there is no data-theme, so fall back to the OS. */
				:root[data-theme="dark"] {
					--er-bg: #101319; --er-ink: #f3f4ef; --er-muted: #9a9eaa;
					--er-line: #2b303a; --er-accent: #c2f16b; --er-code-bg: #171b23;
				}
				@media (prefers-color-scheme: dark) {
					:root:not([data-theme="light"]) {
						--er-bg: #101319; --er-ink: #f3f4ef; --er-muted: #9a9eaa;
						--er-line: #2b303a; --er-accent: #c2f16b; --er-code-bg: #171b23;
					}
				}
				body {
					position: relative;
					font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
					background: var(--er-bg); color: var(--er-ink);
					padding: 0; margin: 0;
					-webkit-font-smoothing: antialiased;
				}
				.topnav {
					display: flex; align-items: center; gap: 18px;
					padding: 12px 24px; border-bottom: 1px solid var(--er-line);
				}
				.topnav a { color: var(--er-ink); text-decoration: none; }
				.topnav .brand { font-weight: 700; letter-spacing: -0.5px; }
				.topnav .brand .accent { color: var(--er-accent); }
				.topnav .nav-search { flex: 1; max-width: 420px; }
				.topnav .nav-search input {
					width: 100%; padding: 6px 12px; font-size: 14px;
					border: 1px solid var(--er-line); border-radius: 6px;
					background: var(--er-bg); color: var(--er-ink);
				}
				.topnav nav { margin-left: auto; display: flex; align-items: center; gap: 16px; font-size: 14px; }
				.topnav .nav-user { /*color: var(--er-muted);*/ }
				.topnav .nav-user:hover { color: var(--er-accent); }
				.topnav a:hover { color: var(--er-accent); }
				.topnav form.inline { display: inline; margin: 0; }
				.topnav form.inline button {
					background: none; border: none; padding: 0; cursor: pointer;
					color: var(--er-ink); font-size: 14px;
				}
				.topnav button.theme-toggle {
					display: inline-flex; align-items: center; justify-content: center;
					width: 30px; height: 30px; padding: 0; cursor: pointer;
					background: none; border: 1px solid var(--er-line);
					border-radius: 6px; color: var(--er-ink);
				}
				.topnav button.theme-toggle:hover {
					color: var(--er-accent); border-color: var(--er-accent);
				}
				.theme-toggle svg { width: 15px; height: 15px; display: block; }
				.theme-toggle .icon-sun { display: none; }
				:root[data-theme="dark"] .theme-toggle .icon-sun { display: block; }
				:root[data-theme="dark"] .theme-toggle .icon-moon { display: none; }
				.er-shell {
					display: flex; gap: 40px; align-items: flex-start; justify-content: center;
					width: min(1120px, calc(100% - 48px)); margin: 0 auto;
				}
				.er-page { flex: 1 1 auto; min-width: 0; padding-block: 40px; }
				.er-sidebar { flex: 0 0 260px; padding-block: 40px; }
				.tip-card {
					position: sticky; top: 24px;
					border: 1px solid var(--er-line); border-radius: 10px; padding: 16px 18px;
				}
				.tip-card h2 {
					margin: 0 0 10px; font-size: 13px; font-weight: 650;
					letter-spacing: 1.4px; text-transform: uppercase; color: var(--er-accent);
				}
				.tip-list { margin: 0; padding-left: 18px; display: grid; gap: 8px; font-size: 13px; color: var(--er-muted); }
				.tip-list li { line-height: 1.5; }
				@media (max-width: 900px) {
					.er-shell { flex-direction: column; gap: 0; }
					.er-page { width: 100%; }
					.er-sidebar { flex: none; width: 100%; padding-top: 0; }
				}
				.er-muted { color: var(--er-muted); }
				code {
					font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
					font-size: .9em; background: var(--er-code-bg);
					border-radius: 5px; padding: 1px 5px;
				}
				.er-code {
					font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
					font-size: .9em; background: var(--er-code-bg); border: 1px solid var(--er-line);
					border-radius: 6px; padding: 12px 16px; white-space: pre; overflow-x: auto;
				}
				.er-btn {
					display: inline-block; padding: 6px 14px; font-size: 14px; cursor: pointer;
					border: 1px solid var(--er-line); border-radius: 6px;
					background: var(--er-code-bg); color: var(--er-ink); text-decoration: none;
				}
				.er-input {
					width: 100%; padding: 8px 12px; font-size: 14px; margin-top: 4px;
					border: 1px solid var(--er-line); border-radius: 6px;
					background: var(--er-bg); color: var(--er-ink);
				}
				.er-field { margin-bottom: 16px; }
				.er-field label { font-size: 13px; color: var(--er-muted); }
				.er-error {
					padding: 10px 14px; margin-bottom: 16px; font-size: 14px;
					border: 1px solid #c66; border-radius: 6px; color: #b3453a;
				}
				.er-footer {
					width: min(1120px, calc(100% - 48px)); margin: 0 auto;
					padding: 20px 0 36px; border-top: 1px solid var(--er-line);
					display: flex; flex-wrap: wrap; gap: 16px; align-items: center;
					font-size: 13px; color: var(--er-muted);
				}
				.er-footer a { color: var(--er-muted); text-decoration: none; }
				.er-footer a:hover { color: var(--er-accent); }
			</style>
			@assets.Stylesheet()
			if utils.AppConfig().IsLocal {
				<script src={ templ.URL(utils.URLPrefix() + "/assets/livereload.js") } data-ws={ utils.URLPrefix() + "/ws" } defer></script>
			}
			@assets.Scripts()
		</head>
		<body>
			<header class="topnav">
				<a class="brand" href="/">Emo Registry</a>
				<form class="nav-search" action="/search" method="get">
					<input type="search" autocomplete="off" name="q" placeholder="Search packages…"/>
				</form>
				<nav>
					if username != "" {
						<a class="nav-user" href={ templ.SafeURL("/u/" + username) }>{ username }</a>
						<a href="/orgs">Orgs</a>
						<a href="/tokens">Tokens</a>
						if admin {
							<a href="/admin">Admin</a>
						}
						<form class="inline" method="post" action="/logout">
							<button type="submit">Logout</button>
						</form>
					} else {
						if admin {
							<a href="/admin">Admin</a>
						}
						<a href="/login">Login</a>
						<a href="/signup">Signup</a>
					}
					<button class="theme-toggle" type="button" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
						<svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
						</svg>
						<svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="12" cy="12" r="4"></circle>
							<path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
						</svg>
					</button>
				</nav>
			</header>
			<div class="er-shell">
				{ children... }
				if o.ShowSidebar {
					@Sidebar()
				}
			</div>
			<footer class="er-footer">
				<a href="/terms">Terms of Service</a>
			</footer>
			<script>
				// Flip between light and dark, remembering the choice.
				(function () {
					var button = document.getElementById("theme-toggle");
					if (!button) return;
					button.addEventListener("click", function () {
						var next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
						document.documentElement.dataset.theme = next;
						try { localStorage.setItem("theme", next); } catch (e) {}
					});
				})();
			</script>
		</body>
	</html>
}
