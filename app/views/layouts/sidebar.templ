package layouts

// Sidebar renders the right-hand tips column: short, static hints about
// scopes, tokens and publishing that a newcomer would otherwise have to
// discover the hard way. It is shown only where BaseOptions.ShowSidebar is
// set (the home page).
templ Sidebar() {
	<aside class="er-sidebar">
		<div class="tip-card">
			<h2>Tips</h2>
			<ul class="tip-list">
				<li>Your username is a package scope — publish <code>yourname/pkg</code> right away; create an organization only to share a scope with a team.</li>
				<li>Create an API token on the <a href="/tokens" style="color: green;">Tokens</a> page to run <code>emo emoji publish</code>.</li>
				<li>Mark a package private to hide it from everyone outside your team.</li>
				<li>Versions are immutable once published — yank a version instead of overwriting it.</li>
			</ul>
		</div>
	</aside>
}
