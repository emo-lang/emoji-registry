package search

import (
	"strconv"

	"github.com/emo-lang/emoji-registry/app/models"
	"github.com/emo-lang/emoji-registry/app/views/layouts"
	"github.com/emo-lang/emoji-registry/app/views/packages"
)

// Results renders the search results page for query q with simple
// prev/next pagination.
templ Results(username string, q string, results []*models.Package, page int, perPage int, total int64) {
	@layouts.Base("Search: "+q, username) {
		<main class="er-page">
			@packages.CardStyles()
			<style>
				.pager { display: flex; gap: 14px; margin-top: 20px; font-size: 14px; }
				.pager a { color: var(--er-accent); text-decoration: none; }
				.pager .cur { color: var(--er-muted); }
			</style>
			<h1>Search</h1>
			if q == "" {
				<p class="er-muted">Type a query to search packages by name or description.</p>
			} else {
				<p class="er-muted">{ strconv.FormatInt(total, 10) } result(s) for "{ q }"</p>
				for _, pkg := range results {
					@packages.Card(pkg)
				}
				if total > 0 {
					<div class="pager">
						if page > 1 {
							<a href={ templ.SafeURL("/search?q=" + q + "&page=" + strconv.Itoa(page-1)) }>← Previous</a>
						}
						<span class="cur">Page { strconv.Itoa(page) }</span>
						if int64(page*perPage) < total {
							<a href={ templ.SafeURL("/search?q=" + q + "&page=" + strconv.Itoa(page+1)) }>Next →</a>
						}
					</div>
				}
			}
		</main>
	}
}
